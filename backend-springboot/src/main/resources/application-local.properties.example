# Copy this file to application-local.properties and put your own local values there.
# Do not commit application-local.properties.

server.port=5001

spring.datasource.url=jdbc:mysql://localhost:3306/arogya_rural?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_mysql_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
logging.level.root=INFO
logging.level.org.hibernate.SQL=OFF
logging.level.org.springframework.jdbc.core=INFO

jwt.secret=change-this-to-a-long-random-local-secret
jwt.expiration-ms=604800000

app.cors.allowed-origins=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: set this only once you have downloaded/exported the complete LGD CSV.
# Example:
# app.locations.import-csv=/Users/shwet/Downloads/lgd_locations.csv
# app.locations.force-import=false
